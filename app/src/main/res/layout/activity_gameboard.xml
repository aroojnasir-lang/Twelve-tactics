<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:padding="12dp">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:text="‹"
        android:textSize="30sp"
        android:textColor="#F5D98A"
        android:backgroundTint="#073B30"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Players information -->

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#073B30"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You"
                android:textColor="#FFFFFF"
                android:textSize="19sp"/>

            <TextView
                android:id="@+id/tvPlayerScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Points: 0"
                android:textColor="#F5D98A"
                android:textSize="17sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="VS"
            android:textColor="#F5D98A"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOpponentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI"
                android:textColor="#FFFFFF"
                android:textSize="19sp"/>

            <TextView
                android:id="@+id/tvOpponentScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Points: 0"
                android:textColor="#D0D0D0"
                android:textSize="17sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Playable board container -->

    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="6dp"
        android:background="#553522"
        app:layout_constraintWidth_max="420dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/topPanel"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <GridLayout
            android:id="@+id/gameBoardGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:rowCount="5"
            android:columnCount="5"
            android:useDefaultMargins="false"
            android:alignmentMode="alignBounds">

            <!-- Row 1 -->
            <Button android:id="@+id/cell00" style="@style/GameCell"/>
            <Button android:id="@+id/cell01" style="@style/GameCell"/>
            <Button android:id="@+id/cell02" style="@style/GameCell"/>
            <Button android:id="@+id/cell03" style="@style/GameCell"/>
            <Button android:id="@+id/cell04" style="@style/GameCell"/>

            <!-- Row 2 -->
            <Button android:id="@+id/cell10" style="@style/GameCell"/>
            <Button android:id="@+id/cell11" style="@style/GameCell"/>
            <Button android:id="@+id/cell12" style="@style/GameCell"/>
            <Button android:id="@+id/cell13" style="@style/GameCell"/>
            <Button android:id="@+id/cell14" style="@style/GameCell"/>

            <!-- Row 3 -->
            <Button android:id="@+id/cell20" style="@style/GameCell"/>
            <Button android:id="@+id/cell21" style="@style/GameCell"/>
            <Button android:id="@+id/cell22" style="@style/GameCell"/>
            <Button android:id="@+id/cell23" style="@style/GameCell"/>
            <Button android:id="@+id/cell24" style="@style/GameCell"/>

            <!-- Row 4 -->
            <Button android:id="@+id/cell30" style="@style/GameCell"/>
            <Button android:id="@+id/cell31" style="@style/GameCell"/>
            <Button android:id="@+id/cell32" style="@style/GameCell"/>
            <Button android:id="@+id/cell33" style="@style/GameCell"/>
            <Button android:id="@+id/cell34" style="@style/GameCell"/>

            <!-- Row 5 -->
            <Button android:id="@+id/cell40" style="@style/GameCell"/>
            <Button android:id="@+id/cell41" style="@style/GameCell"/>
            <Button android:id="@+id/cell42" style="@style/GameCell"/>
            <Button android:id="@+id/cell43" style="@style/GameCell"/>
            <Button android:id="@+id/cell44" style="@style/GameCell"/>

        </GridLayout>

    </FrameLayout>

    <!-- Turn and score information -->

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="125dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#073B30"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTurn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Your Turn"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvGameStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:text="Select your coin"
            android:textColor="#E8D49C"
            android:textSize="16sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
