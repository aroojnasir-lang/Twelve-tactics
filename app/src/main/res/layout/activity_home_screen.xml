<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="start"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/background"
    tools:context=".HomeScreen">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- PROFILE AND CURRENCY BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:gravity="center_vertical"
                android:background="#E619392D"
                android:padding="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="32sp"
                    android:background="@drawable/bg_icon_button" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="guest15"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Points 500"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRedGems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💎 2"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:padding="3dp" />

                <TextView
                    android:id="@+id/tvBlueGems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💎 3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:padding="3dp" />

                <TextView
                    android:id="@+id/btnAddGems"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#593719"
                    android:background="@drawable/bg_icon_button" />

            </LinearLayout>

            <!-- SMALL MENU BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:orientation="horizontal"
                android:layout_marginTop="28dp"
                android:weightSum="3">

                <LinearLayout
                    android:id="@+id/btnLeaderboard"
                    style="@style/SmallMenuCard"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bt_leaderboard"/>

                    <TextView
                        style="@style/SmallMenuText"
                        android:text="LEADERBOARD" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnInvitation"
                    style="@style/SmallMenuCard"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bt_invitation"/>

                    <TextView
                        style="@style/SmallMenuText"
                        android:text="INVITATION" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnGameResult"
                    style="@style/SmallMenuCard"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bt_gameresult"/>

                    <TextView
                        style="@style/SmallMenuText"
                        android:text="Game Result" />
                </LinearLayout>

            </LinearLayout>


            <!-- FIRST ROW: COMPUTER AND ONLINE -->
            <LinearLayout
                android:layout_width="350dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="34dp">

                <LinearLayout
                    android:id="@+id/btnPlayComputer"
                    style="@style/GameWoodCard"
                    android:layout_width="10dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">

                   <ImageView
                       android:layout_width="90dp"
                       android:layout_height="90dp"
                       android:background="@drawable/bt_withcomputer"/>

                    <TextView
                        style="@style/GameCardText"
                        android:text="PLAY WITH\nCOMPUTER"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPlayOnline"
                    style="@style/GameWoodCard"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bt_playonline"/>

                    <TextView
                        style="@style/GameCardText"
                        android:text="PLAY\nONLINE"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- SECOND ROW: LOCAL AND FRIENDS -->
            <LinearLayout
                android:layout_width="350dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:id="@+id/btnLocalMultiplayer"
                    style="@style/GameWoodCard"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:background="@drawable/bt_playoffline"/>

                    <TextView
                        style="@style/GameCardText"
                        android:text="PLAY\n OFFLINE"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPlayFriends"
                    style="@style/GameWoodCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bt_withfriends"/>

                    <TextView
                        style="@style/GameCardText"
                        android:text="PLAY WITH\nFRIENDS"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- BOTTOM NAVIGATION -->

        </LinearLayout>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="350dp"
        android:layout_height="70dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="15dp"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:weightSum="4"
        android:padding="10dp"
        android:background="@drawable/bg_navigationbutton"
        android:elevation="8dp">

        <!-- SHARE -->
        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="5dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:padding="10dp"
            android:background="@drawable/bg_menu_card"
            android:src="@drawable/ic_share"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Share"/>

        <!-- HELP -->
        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:padding="10dp"
            android:background="@drawable/bg_menu_card"
            android:src="@drawable/ic_help"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Help"/>

        <!-- FAVOURITE -->
        <ImageView
            android:id="@+id/btnFavourite"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:padding="10dp"
            android:background="@drawable/bg_menu_card"
            android:src="@drawable/ic_favourite"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Favourite"/>

        <!-- SETTINGS -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:padding="10dp"
            android:background="@drawable/bg_menu_card"
            android:src="@drawable/ic_settings"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Settings"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Logout"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#D9534F"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_margin="16dp" />


</LinearLayout>